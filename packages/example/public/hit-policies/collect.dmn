<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_Collect" name="Collect" namespace="http://miragon.io/miravelo/membership">
  <decision id="Decision_Promos" name="Applicable Leasing Perks">
    <decisionTable id="DT_Collect" hitPolicy="COLLECT">
      <input id="in_cart" label="Monthly Rate (€)">
        <inputExpression id="ie_cart" typeRef="integer"><text>MonthlyRate</text></inputExpression>
      </input>
      <output id="out_promo" label="Perk" name="Perk" typeRef="string" />
      <rule id="c1">
        <inputEntry id="c1i"><text>&gt;= 30</text></inputEntry>
        <outputEntry id="c1o"><text>"Free Inspection"</text></outputEntry>
      </rule>
      <rule id="c2">
        <inputEntry id="c2i"><text>&gt;= 60</text></inputEntry>
        <outputEntry id="c2o"><text>"Insurance Included"</text></outputEntry>
      </rule>
      <rule id="c3">
        <inputEntry id="c3i"><text>&gt;= 90</text></inputEntry>
        <outputEntry id="c3o"><text>"Free Accessory Kit"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
