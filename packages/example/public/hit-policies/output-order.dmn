<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="Definitions_OutputOrder" name="OutputOrder" namespace="http://miragon.io/miravelo/service">
  <decision id="Decision_Warnings" name="Wear Warnings (by severity)">
    <decisionTable id="DT_OutputOrder" hitPolicy="OUTPUT ORDER">
      <input id="in_temp" label="Kilometers Ridden">
        <inputExpression id="ie_temp" typeRef="integer"><text>Kilometers</text></inputExpression>
      </input>
      <output id="out_warn" label="Warning" name="Warning" typeRef="string">
        <outputValues id="ov_warn"><text>"Replace Now","Inspect Soon"</text></outputValues>
      </output>
      <rule id="o1">
        <inputEntry id="o1i"><text>&gt; 3000</text></inputEntry>
        <outputEntry id="o1o"><text>"Inspect Soon"</text></outputEntry>
      </rule>
      <rule id="o2">
        <inputEntry id="o2i"><text>&gt; 6000</text></inputEntry>
        <outputEntry id="o2o"><text>"Replace Now"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
