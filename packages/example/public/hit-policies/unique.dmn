<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/"
             xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/"
             xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/"
             id="Definitions_Unique" name="Unique" namespace="http://miragon.io/miravelo/membership">
  <inputData id="InputData_AnnualSpend" name="Annual Spend (€)">
    <variable id="Variable_AnnualSpend" name="AnnualSpend" typeRef="integer" />
  </inputData>
  <decision id="Decision_Tier" name="Inner-Circle Tier">
    <informationRequirement id="ir_AnnualSpend">
      <requiredInput href="#InputData_AnnualSpend" />
    </informationRequirement>
    <decisionTable id="DT_Unique" hitPolicy="UNIQUE">
      <input id="in_spend" label="Annual Spend (€)">
        <inputExpression id="ie_spend" typeRef="integer"><text>AnnualSpend</text></inputExpression>
      </input>
      <output id="out_tier" label="Tier" name="Tier" typeRef="string" />
      <rule id="u1">
        <inputEntry id="u1i"><text>&lt; 1000</text></inputEntry>
        <outputEntry id="u1o"><text>"Bronze"</text></outputEntry>
      </rule>
      <rule id="u2">
        <inputEntry id="u2i"><text>[1000..5000)</text></inputEntry>
        <outputEntry id="u2o"><text>"Silver"</text></outputEntry>
      </rule>
      <rule id="u3">
        <inputEntry id="u3i"><text>&gt;= 5000</text></inputEntry>
        <outputEntry id="u3o"><text>"Gold"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape id="DMNShape_Decision_Tier" dmnElementRef="Decision_Tier">
        <dc:Bounds height="80" width="180" x="260" y="80" />
      </dmndi:DMNShape>
      <dmndi:DMNShape id="DMNShape_InputData_AnnualSpend" dmnElementRef="InputData_AnnualSpend">
        <dc:Bounds height="45" width="125" x="287" y="230" />
      </dmndi:DMNShape>
      <dmndi:DMNEdge id="DMNEdge_ir_AnnualSpend" dmnElementRef="ir_AnnualSpend">
        <di:waypoint x="350" y="230" />
        <di:waypoint x="350" y="160" />
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
