{
  "name": "@emaarco/dmn-js-simulation",
  "version": "0.1.0",
  "description": "Simulate DMN decision tables directly in a dmn-js modeler — see which rules match and what the decision returns.",
  "type": "module",
  "license": "MIT",
  "author": "Marco Schäck (https://github.com/emaarco)",
  "keywords": [
    "dmn",
    "dmn-js",
    "bpmn.io",
    "decision-table",
    "simulation",
    "drd",
    "feel",
    "hit-policy"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assets/*": "./dist/assets/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:distro": "node test/distro/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --output-type err"
  },
  "dependencies": {
    "feelin": "7.0.1"
  },
  "peerDependencies": {
    "diagram-js": ">=15",
    "dmn-js": ">=17",
    "inferno": ">=5.6 <6"
  },
  "peerDependenciesMeta": {
    "diagram-js": {
      "optional": true
    },
    "dmn-js": {
      "optional": true
    },
    "inferno": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/node": "26.1.1",
    "dependency-cruiser": "18.1.0",
    "dmn-js": "17.10.1",
    "dmn-moddle": "12.0.1",
    "inferno": "5.6.3",
    "inferno-create-element": "5.6.3",
    "jsdom": "29.1.1",
    "rollup": "4.62.3",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emaarco/dmn-simulation.git",
    "directory": "packages/dmn-js-simulation"
  },
  "bugs": {
    "url": "https://github.com/emaarco/dmn-simulation/issues"
  },
  "homepage": "https://github.com/emaarco/dmn-simulation#readme"
}
